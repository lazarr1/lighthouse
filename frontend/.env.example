# ── API mode ─────────────────────────────────────────────────────────────────
#   mock   – everything answered by the in-browser mock (default)
#   hybrid – endpoints in VITE_LIVE_ENDPOINTS go to your backend, the rest are mocked
#   http   – everything goes to your backend
VITE_API_MODE=mock

# Endpoints served by the real backend in hybrid mode. Endpoint names
# (getDataset), tags (Session, Datasets, Records, Charts, Dashboards, Actions,
# Runs, Uploads) or * — comma or space separated. See /dev/api for the list.
VITE_LIVE_ENDPOINTS=Session

# Dev server proxies /v1 to this backend (hybrid, or http with an empty base URL).
# Same-origin through the proxy means no CORS setup and cookies just work.
VITE_API_PROXY_TARGET=http://localhost:8080

# http mode only: absolute backend URL. Leave empty to go through the dev proxy.
VITE_API_BASE_URL=
